# ==============================================================================
# TrustRank Environment Configuration Template
# Real-Time Shopping Research & Recommendation Platform
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
APP_ENV=production

# ------------------------------------------------------------------------------
# 1. Amazon India Creators API (OAuth 2.0)
# Register at: https://affiliate-program.amazon.in/creatorsapi
# ------------------------------------------------------------------------------
AMAZON_CREATORS_CREDENTIAL_ID=your_amazon_creators_credential_id_here
AMAZON_CREATORS_CREDENTIAL_SECRET=your_amazon_creators_credential_secret_here
AMAZON_CREATORS_CREDENTIAL_VERSION=your_amazon_creators_credential_version_here
AMAZON_CREATORS_PARTNER_TAG=your_amazon_associate_tag_here
AMAZON_CREATORS_TOKEN_ENDPOINT=https://api.amazon.co.uk/auth/o2/token

# ------------------------------------------------------------------------------
# 2. Flipkart Official Affiliate API
# Register at: https://affiliate.flipkart.com/
# ------------------------------------------------------------------------------
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here

# ------------------------------------------------------------------------------
# 3. RapidAPI Real-Time E-Commerce Data APIs (Amazon India & Flipkart)
# Real-time search, prices in INR, ratings, and reviews from Amazon.in & Flipkart.com
# Register at: https://rapidapi.com/
# ------------------------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_FLIPKART_HOST=real-time-flipkart-data.p.rapidapi.com

# ------------------------------------------------------------------------------
# 4. SerpApi Multi-Merchant Search (Google Shopping India / Amazon Data in INR)
# Returns live merchant offers from Amazon India, Flipkart, Croma, and Reliance Digital in INR.
# Register at: https://serpapi.com/
# ------------------------------------------------------------------------------
SERPAPI_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# 5. Open Product Data & Public Feeds
# ------------------------------------------------------------------------------
ENABLE_OPEN_DATA_PROVIDER=True

# ------------------------------------------------------------------------------
# 6. Bright Data Amazon dataset scraper
# ------------------------------------------------------------------------------
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Optional image generation/analysis provider. Keep real values only in backend/.env.
OPENAI_API_KEY=your_openai_api_key_here
IMAGE_PROVIDER_API_KEY=your_image_provider_api_key_here

# ------------------------------------------------------------------------------
# 7. Croma Electronics Provider
# ------------------------------------------------------------------------------
CROMA_API_KEY=your_croma_api_key_here
ENABLE_CROMA_PROVIDER=True

# ------------------------------------------------------------------------------
# 8. Email Notification Service (SMTP)
# Used for Price Drop Alerts and Account Welcome Emails.
# For Gmail: Use smtp.gmail.com, port 587, and generate a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords).
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SMTP_TLS=True
EMAILS_FROM_EMAIL=alerts@trustrank.ai
EMAIL_FROM=alerts@trustrank.ai
AUTH_DB_PATH=trustrank_users.db

